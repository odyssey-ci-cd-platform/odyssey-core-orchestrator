{
  "pipeline": "demo",
  "stages": ["build", "test"],
  "jobs": {
    "compile": {
      "stage": "build",
      "image": "alpine",
      "setup": ["apk add git"],
      "env": { "KEY": "value" },
      "steps": [{ "name": "compile", "run": "make", "timeout_ms": 300000 }]
    },
    "unit": {
      "stage": "test",
      "image": "golang",
      "steps": [{ "name": "unit", "run": "go test ./...", "timeout_ms": 600000 }]
    }
  }
}
